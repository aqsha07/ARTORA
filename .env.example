# ARTORA Environment Configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=artora-super-secret-craft-key-2026-unlimited

# Database Configuration
# Default is set to SQLite for zero-config local development,
# but can be easily switched to MySQL by uncommenting below:
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/artora_db
DATABASE_URL=sqlite:///artora.db

# Razorpay Test Mode Credentials
# Using official test key format (replace with your active Razorpay test keys if desired)
RAZORPAY_KEY_ID=rzp_test_ARTORA2026DEMO
RAZORPAY_KEY_SECRET=artoraSecretKeyTestMode2026
RAZORPAY_CURRENCY=INR
